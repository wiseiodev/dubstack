{
  "name": "dubstack-retarget-action",
  "version": "1.0.0",
  "description": "GitHub Action that retargets dependent Dubstack PRs when a stack PR merges.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --target es2023 --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^9.1.1",
    "@octokit/plugin-retry": "^7.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@vercel/ncc": "^0.38.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
