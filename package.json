{
  "name": "dubstack-workspace",
  "private": true,
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "check:all": "pnpm checks:fix:unsafe && pnpm typecheck && pnpm test && pnpm evals",
    "cli:dev": "pnpm --filter dubstack exec tsx src/index.ts",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "checks": "biome check .",
    "checks:fix": "biome check --write .",
    "checks:fix:unsafe": "biome check --write --unsafe .",
    "dev": "turbo run dev",
    "evals": "evalite run",
    "evals:watch": "evalite watch",
    "evals:export": "evalite export --output .evalite-export"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "evalite": "0.19.0",
    "semantic-release": "^25.0.1",
    "turbo": "^2.9.14"
  }
}
