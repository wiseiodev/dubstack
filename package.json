{
  "name": "dubstack-workspace",
  "private": true,
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "checks": "biome check .",
    "checks:fix": "biome check --write .",
    "checks:fix:unsafe": "biome check --write --unsafe .",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "turbo": "^2.5.0"
  }
}
