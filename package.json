{
	"name": "dubstack",
	"version": "0.5.1",
	"description": "CLI tool for managing stacked diffs (dependent git branches)",
	"type": "module",
	"bin": {
		"dub": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wiseiodev/dubstack.git"
	},
	"scripts": {
		"build": "tsup",
		"prepack": "pnpm build",
		"dev": "tsx src/index.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"checks": "biome check .",
		"checks:fix": "biome check --write ."
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.29.1",
	"keywords": [
		"git",
		"stacked-diffs",
		"cli",
		"branches"
	],
	"license": "MIT",
	"dependencies": {
		"@inquirer/search": "^4.1.3",
		"chalk": "^5.6.2",
		"commander": "^14.0.3",
		"execa": "^9.6.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.2",
		"@types/node": "^25.2.3",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	}
}
